<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <Compile Include="obj/capacity-sources/Capacity16.fs" />
    <Compile Include="obj/capacity-sources/Checks16.fs" />
    <Compile Include="obj/capacity-sources/Capacity32.fs" />
    <Compile Include="obj/capacity-sources/Checks32.fs" />
    <Compile Include="obj/capacity-sources/Capacity64.fs" />
    <Compile Include="obj/capacity-sources/Checks64.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <Target Name="GenerateCapacityVariants" BeforeTargets="BeforeCompile">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/Generate-Capacities.ps1&quot;" />
  </Target>
</Project>
